<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>X.Web.MetaExtractor</Title>
        <Description>X.Web.MetaExtractor is a powerful library that allows you to extract meta information from any web page.</Description>

        <LangVersion>default</LangVersion>

        <PackageTags>web html metadata</PackageTags>

        <Nullable>enable</Nullable>

        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../LICENSE.md" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../../x-web.png" Pack="True" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    </ItemGroup>

    <!-- Keep LTS consumers (.NET 10) on Microsoft.Extensions 10.x;
         only the net11.0 build depends on Microsoft.Extensions 11.x. -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    </ItemGroup>
</Project>
